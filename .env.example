NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://antriin:antriin_local_only@127.0.0.1:5433/antriin
DATABASE_POOL_MAX=10
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
LOG_LEVEL=info
# Optional in development (auth returns 503 until configured); required in production.
# Generate independent keys locally; never commit their values.
AUTH_SECRET=
AUTH_ENCRYPTION_KEY=
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_SESSION_TTL_SECONDS=86400
AUTH_OTP_DELIVERY_MAX_ATTEMPTS=5
# Order/proposal/pickup timing policy (pilot defaults; see docs/PILOT-POLICY.md).
ORDER_PROPOSAL_TTL_SECONDS=600
ORDER_PREPARATION_LEAD_SECONDS=900
PICKUP_CREDENTIAL_TTL_SECONDS=7200
# Top-up payments: 'disabled' rejects provider calls; 'sandbox' is local/testing only
# and is refused when NODE_ENV=production. Never commit a real webhook secret.
PAYMENTS_PROVIDER_MODE=disabled
PAYMENTS_TOPUP_MIN_MINOR=1000
PAYMENTS_TOPUP_MAX_MINOR=2000000
# Sandbox top-up intent lifetime in seconds (informational; no expiry sweeper yet).
PAYMENTS_SANDBOX_TOPUP_TTL_SECONDS=3600
# Required (>=32 chars) when PAYMENTS_PROVIDER_MODE=sandbox.
PAYMENTS_SANDBOX_WEBHOOK_SECRET=

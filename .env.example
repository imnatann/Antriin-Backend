NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:3001
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://antriin:antriin_local_only@127.0.0.1:5433/antriin
DATABASE_POOL_MAX=10
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
LOG_LEVEL=info
# Optional in development (auth returns 503 until configured); required in production.
# Generate independent keys locally; never commit their values.
AUTH_SECRET=
AUTH_ENCRYPTION_KEY=
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_SESSION_TTL_SECONDS=86400
AUTH_OTP_DELIVERY_MAX_ATTEMPTS=5
# Pilot/dev only: write OTP codes to the log instead of sending them.
# Independent of NODE_ENV. Turn off before real users exist.
AUTH_OTP_DEV_ECHO=false
# Email OTP delivery through Resend (https://resend.com). Both are required in
# production unless AUTH_OTP_DEV_ECHO=true. AUTH_OTP_FROM_EMAIL must be a bare
# address on a domain verified in Resend; never commit a real key.
RESEND_API_KEY=
AUTH_OTP_FROM_EMAIL=
# Order/proposal/pickup timing policy (pilot defaults; see docs/PILOT-POLICY.md).
ORDER_PROPOSAL_TTL_SECONDS=600
ORDER_PREPARATION_LEAD_SECONDS=900
PICKUP_CREDENTIAL_TTL_SECONDS=7200
# Top-up payments: 'disabled' rejects provider calls; 'sandbox' is a local stub
# with no network; 'xendit' calls the real Xendit sandbox QR API. All three are
# refused when NODE_ENV=production. Never commit a real webhook secret.
PAYMENTS_PROVIDER_MODE=disabled
PAYMENTS_TOPUP_MIN_MINOR=1000
PAYMENTS_TOPUP_MAX_MINOR=2000000
# Sandbox top-up intent lifetime in seconds (informational; no expiry sweeper yet).
PAYMENTS_SANDBOX_TOPUP_TTL_SECONDS=3600
# Refund provider: 'disabled' rejects provider calls; 'sandbox' is local/testing only
# and is refused when NODE_ENV=production.
REFUNDS_PROVIDER_MODE=disabled
# Payout provider: 'disabled' rejects provider calls; 'sandbox' is local/testing only
# and is refused when NODE_ENV=production.
PAYOUTS_PROVIDER_MODE=disabled
# Required (>=32 chars) when PAYMENTS_PROVIDER_MODE=sandbox.
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
# Xendit sandbox credentials. Required only when PAYMENTS_PROVIDER_MODE=xendit.
# Secret key: Dashboard > Settings > API Keys > Generate Secret Key (test mode).
# Grant Money-in write (create QR) and read.
XENDIT_SECRET_KEY=
# Verification token: Dashboard > Settings > Webhooks > Callback token. It is
# compared in constant time against the x-callback-token header.
XENDIT_CALLBACK_TOKEN=
# API base; leave the default unless pointing at a local stub in tests.
XENDIT_API_BASE_URL=https://api.xendit.co
# Image uploads (POST /media). Files are written here and served from
# GET /media/{id}; use an absolute path on a host outside local development.
MEDIA_ROOT=./storage/media
# Maximum size of one uploaded image in bytes (1024..20971520).
MEDIA_MAX_BYTES=5242880
# When set, GET /metrics requires "Authorization: Bearer <token>".
# Leave empty only on a private host.
METRICS_TOKEN=
# Lifetime of one SSE connection (GET /events/stream) before the client must
# reconnect; keeps a long-lived stream from pinning a worker forever.
EVENTS_STREAM_MAX_SECONDS=900
